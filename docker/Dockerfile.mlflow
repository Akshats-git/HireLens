# =============================================================================
# HireLens MLflow Tracking Server
# Packages are baked in at build time — no runtime pip installs.
# =============================================================================
FROM python:3.12.3-slim

LABEL maintainer="HireLens Team"
LABEL description="HireLens MLflow Tracking Server"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    mlflow==2.14.3 \
    boto3==1.34.144 \
    psycopg2-binary==2.9.9

WORKDIR /mlflow

EXPOSE 5000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -sf http://0.0.0.0:5000/health || exit 1

ENTRYPOINT ["mlflow", "server"]
