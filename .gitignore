# =============================================================================
# HireLens .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
/sdist/
/wheels/
*.egg-info/
*.egg

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.prod
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# ── ML / Model Artifacts ──────────────────────────────────────────────────────
# Trailing comments are not supported in .gitignore patterns — keep lines bare.
models/cache/
models/fine_tuned/
models/checkpoints/
*.bin
*.safetensors
*.onnx
*.pt
*.pth

# ── Data (DVC manages these) ──────────────────────────────────────────────────
data/raw/
data/processed/
data/eval/
data/synthetic/
uploads/
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── DVC ───────────────────────────────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlflow/artifacts/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.cache/
