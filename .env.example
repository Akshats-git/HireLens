# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-256-bit-hex-string
APP_DEBUG=true
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# ── Backend API ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true                            # Set false in production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hirelens
POSTGRES_USER=hirelens_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://hirelens_user:change-me-strong-password@localhost:5432/hirelens

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=hirelens-resume-matching
MLFLOW_S3_ENDPOINT_URL=                   # Leave blank for AWS, set for MinIO
MLFLOW_ARTIFACT_ROOT=s3://hirelens-mlflow-artifacts/

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=hirelens-data
AWS_S3_MODELS_PREFIX=models/
AWS_S3_DATA_PREFIX=data/

# ── Model Configuration ───────────────────────────────────────────────────────
MODEL_CACHE_DIR=./models/cache
BASE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FINE_TUNED_MODEL_PATH=./models/fine_tuned/hirelens_matcher
SPACY_MODEL=en_core_web_trf

# ── DVC / Data Versioning ─────────────────────────────────────────────────────
DVC_REMOTE_URL=s3://hirelens-data/dvc-store

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MAX_BULK_RESUMES=50
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
