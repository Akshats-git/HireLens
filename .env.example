# =============================================================================
# HireLens — environment template
# Copy to .env and fill in. Every variable below is read either by application
# code or by docker-compose; nothing here is aspirational.
# =============================================================================

# ── Backend API ───────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Uvicorn worker count (docker/Dockerfile.backend). Use 1 on small instances.
API_WORKERS=4
API_PORT=8000
FRONTEND_PORT=3000

# ── Redis (embedding/analysis cache) ──────────────────────────────────────────
# Optional — the API falls back to an in-process TTL cache if unreachable.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ── PostgreSQL (MLflow backend store) ─────────────────────────────────────────
POSTGRES_DB=hirelens
POSTGRES_USER=hirelens_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=hirelens-resume-matching
MLFLOW_PORT=5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
# Set only when using MinIO or another S3-compatible endpoint.
MLFLOW_S3_ENDPOINT_URL=

# ── AWS (S3 artifact store, DVC remote, CloudWatch metrics) ───────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# ── Kaggle (dataset ingestion) ────────────────────────────────────────────────
# Alternative to ~/.kaggle/kaggle.json or ~/.kaggle/access_token.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Deployment (docker-compose.prod.yml) ──────────────────────────────────────
# GitHub username owning the ghcr.io images, lowercased.
GHCR_USER=your-github-username
